# Copy this file to `.env` (gitignored) for local `netlify dev`, and set the
# same variables in the Netlify UI (Site settings -> Environment variables) for
# the deployed site. NEVER commit the real token.

# Airtable Personal Access Token. Scope it to the "Balance Board Analytics" base
# with data.records:read + data.records:write. Looks like: pat<...>.<...>
AIRTABLE_PAT=

# Airtable base id (the "Balance Board Analytics" base).
AIRTABLE_BASE_ID=appCoGPA1LTG7TO6g
